rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
  
    // Helper function to check auth
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper to check if user owns the document 
    function isSelf(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // --- Users Collection ---
    // Documents are indexed by UID. 
    match /users/{userId} {
      allow read: if isSelf(userId);
      // Allow create: standard creation
      allow create: if isSelf(userId);
      
      // Allow update: BUT restrict modifying 'role', 'isPremium', 'premiumActivatedAt'
      // effectively making them read-only for the client (except via backend/mock flow).
      // For the MOCK FLOW (Client-side upgrade), we will temporarily allow it if premiumSource is 'dev'.
      // In a real production environment with a backend, we would BLOCK 'role' updates entirely from client.
      allow update: if isSelf(userId) 
                    && (
                      // 1. Normal update (not touching premium fields)
                      (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'isPremium', 'premiumActivatedAt']))
                      ||
                      // 2. Dev Mode Exception: Allow upgrade if source is 'dev' or 'manual'
                      (request.resource.data.premiumSource == 'dev' || request.resource.data.premiumSource == 'manual')
                    );
    }

    // --- Expenses Collection ---
    match /expenses/{expenseId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid 
                    && request.resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // --- Goals Collection ---
    match /goals/{goalId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid 
                    && request.resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }
    
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
